# ------------------------------------------------------------------------------
# 6. DASHBOARD CONFIGURATION (STUDIO)
#    Akses visual admin panel via http://[IP-Sekolah]:3000
# ------------------------------------------------------------------------------
STUDIO_DEFAULT_ORGANIZATION=CBT School
STUDIO_DEFAULT_PROJECT=CBT Enterprise
STUDIO_PORT=3000

# [SECURED] KREDENSIAL KEAMANAN REVERSE PROXY NGINX (Zero-Trust)
DASHBOARD_USERNAME=admin@cbtschool.com
DASHBOARD_PASSWORD='4121Wijaya*@?'

# ------------------------------------------------------------------------------
# 7. PERFORMANCE & STORAGE TUNING (HIGH LOAD OPTIMIZATION)
# ------------------------------------------------------------------------------
# Limit Baris Data (Sangat penting untuk export nilai)
PGRST_DB_MAX_ROWS=999999

# Timeout setting (5 menit - cukup untuk query export nilai terbesar)
STATEMENT_TIMEOUT=300s

# [UPDATED] STORAGE LIMITS
# Max upload 50MB - cukup untuk gambar soal HD, logo sekolah, dan dokumen PDF
# (5MB terlalu kecil untuk gambar kualitas tinggi / PDF soal)
FILE_SIZE_LIMIT=52428800

# ------------------------------------------------------------------------------
# 8. [TAMBAHAN 2026] SUPABASE V14 & SECURITY UPGRADES
# ------------------------------------------------------------------------------
# Mengaktifkan penyimpanan lokal permanen untuk Snippet SQL (Menghindari hilang saat restart)
SNIPPETS_MANAGEMENT_FOLDER=/var/lib/snippets

# Menonaktifkan GraphQL secara default (Sesuai changelog 2026) untuk menghemat RAM VHD
# karena CBT Enterprise murni menggunakan standard REST API.
GRAPHQL_ENABLED=false

# Memblokir akses skema database secara publik via OpenAPI (Security Patch Maret 2026)
# Mencegah siswa/hacker mengintip struktur tabel soal dari luar.
PGRST_OPENAPI_SERVER_PROXY_URI=http://localhost:8000
PGRST_OPENAPI_SECURITY_ACTIVE=true

# Mengaktifkan JWT Cache untuk PostgREST v14 
# (Meningkatkan kecepatan load saat ribuan siswa login dan akses soal ujian bersamaan)
PGRST_JWT_CACHE_MAX_LIFETIME=3600
